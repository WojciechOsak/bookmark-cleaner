{
  "manifest_version": 3,
  "name": "Bookmark Cleaner",
  "version": "2.3.1",
  "description": "Wygodne przeglądanie, przenoszenie i usuwanie folderów oraz zakładek Chrome.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Otwórz Bookmark Cleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "manager.html"
}
